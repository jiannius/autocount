{
    "name": "jiannius/autocount",
    "description": "Jiannius Autocount API Wrapper",
    "type": "library",
    "require": {
        "doctrine/dbal": "^3.6|^4.0",
        "symfony/http-client": "^6.0|^7.0"
    },
    "require-dev": {
        "laravel/pail": "^1.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^5.3"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Jiannius\\Autocount\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jiannius\\Autocount\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "TJ",
            "email": "tj@jiannius.com"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Jiannius\\Autocount\\AutocountServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": false,
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "pestphp/pest-plugin": true
        }
    }
}
